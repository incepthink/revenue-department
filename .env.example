# `make env` (rci init-env) copies this to .env with fresh vault keys. All settings use the RCI_ prefix; see services/api/src/rci/config.py.

RCI_DATABASE_URL=postgresql+psycopg://rci:rci@localhost:5434/rci
RCI_TEST_DATABASE_URL=postgresql+psycopg://rci:rci@localhost:5434/rci_test
RCI_REDIS_URL=redis://localhost:6379/0

# Blob storage: local | azurite | azure
RCI_STORAGE_BACKEND=azurite
RCI_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# inline = process in the calling process (CLI/tests); queue = enqueue on Redis for services/worker
RCI_PIPELINE_MODE=inline

# PII vault (AES-256-GCM). DEV KEYS ONLY — generate real ones with `python -m rci.cli gen-keys`.
RCI_VAULT_KEY_B64=REPLACE_WITH_gen-keys_OUTPUT
RCI_VAULT_HMAC_KEY_B64=REPLACE_WITH_gen-keys_OUTPUT
RCI_VAULT_KEY_ID=dev-1

# Auth token signing secret (HS256). `rci init-env` fills it; rotate to log everyone out.
RCI_AUTH_SECRET=REPLACE_WITH_gen-keys_OUTPUT
RCI_AUTH_TOKEN_TTL_MINUTES=480

# ---- LLM: openai | none -------------------------------------------------------------------
# All AI calls go directly to the OpenAI API with OPENAI_API_KEY (below). Azure OpenAI is not used.
RCI_LLM_PROVIDER=openai
RCI_OPENAI_MODEL=gpt-6-luna

# ---- Embeddings: local (deterministic hashing, no network) | openai (uses OPENAI_API_KEY) ------
RCI_EMBEDDING_PROVIDER=local
RCI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- OCR: primary azure_di | tesseract | none; fallback llm_vision | none --------------
RCI_OCR_PRIMARY=none
RCI_OCR_FALLBACK=none
RCI_OCR_FALLBACK_THRESHOLD=0.80
RCI_AZURE_DI_ENDPOINT=
RCI_AZURE_DI_KEY=
RCI_AZURE_DI_REGION=centralindia
RCI_AZURE_DI_MODEL=prebuilt-read

# OpenAI API key used for every AI call (LLM, LLM-vision OCR fallback, openai embeddings)
OPENAI_API_KEY=
